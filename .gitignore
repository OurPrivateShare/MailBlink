# Node.js 依赖与本地包缓存
node_modules/
.npm/

# Cloudflare Wrangler 缓存、构建文件与本地 D1 数据
/.wrangler/

# 本地密钥与环境配置（保留可提交的示例文件）
.dev.vars
.dev.vars.*
!.dev.vars.example
!.dev.vars.*.example
.env
.env.*
!.env.example
!.env.*.example

# 构建产物与缓存
/dist/
/build/
/.cache/
*.tsbuildinfo

# 日志与调试输出
/logs/
*.log
npm-debug.log*

# 测试覆盖率产物
/coverage/
/.nyc_output/

# 编辑器本地文件（保留 VS Code 共享配置）
/.idea/
/.vscode/*
!/.vscode/settings.json
!/.vscode/tasks.json
!/.vscode/launch.json
!/.vscode/extensions.json
!/.vscode/*.code-snippets
/.history/
*.swp
*.swo
*~

# 临时文件
/tmp/
/temp/
*.tmp
*.temp

# 操作系统生成的文件
.DS_Store
._*
Thumbs.db
Desktop.ini
